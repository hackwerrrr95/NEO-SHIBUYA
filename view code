body::after, html::before, html::after {
  content: "";
  position: fixed;
  left: -90px;
  width: calc(100vw + 180px);
  z-index: 1000;
  pointer-events: none;
  background-repeat: repeat;
  will-change: transform;
}
body::after {
  top: -700px;
  height: calc(100vh + 700px);
  background-image: var(--ns-petals-near);
  background-size: 700px 700px;
  opacity: 0.85;
  animation: ns-fall-near 16s linear infinite, ns-sway 6s ease-in-out infinite alternate;
}
html::before {
  top: -820px;
  height: calc(100vh + 820px);
  background-image: var(--ns-petals-mid);
  background-size: 820px 820px;
  opacity: 0.65;
  filter: blur(0.5px);
  animation: ns-fall-mid 28s linear infinite, ns-sway 8s ease-in-out infinite alternate-reverse;
}
html::after {
  top: -960px;
  height: calc(100vh + 960px);
  background-image: var(--ns-petals-far);
  background-size: 960px 960px;
  opacity: 0.5;
  filter: blur(1px);
  animation: ns-fall-far 42s linear infinite, ns-sway 10s ease-in-out infinite alternate;
}

/
@keyframes ns-fall-near { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(0, 700px, 0); } }
@keyframes ns-fall-mid  { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(0, 820px, 0); } }
@keyframes ns-fall-far  { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(0, 960px, 0); } }
@keyframes ns-sway      { from { translate: -45px 0; } to { translate: 45px 0; } }

@media (prefers-reduced-motion: reduce) {
  body::after, html::before, html::after { display: none; }
}


[class*="modeSelected"] [class*="name_"]::after {
  content: " ✿";
  color: var(--ns-sakura);
  text-shadow: 0 0 8px rgba(255, 183, 213, 0.9);
}
